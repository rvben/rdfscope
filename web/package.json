{
  "name": "rdfscope-interface",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node ../scripts/frontend-licenses.mjs",
    "test": "vitest run src",
    "format": "prettier --write src index.html vite.config.ts",
    "format:check": "prettier --check src index.html vite.config.ts",
    "build:browser": "vite build --mode browser && node ../scripts/frontend-licenses.mjs dist-browser",
    "preview:browser": "vite preview --mode browser --host 127.0.0.1",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@xyflow/react": "^12.10.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.7",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.0",
    "wrangler": "4.132.0"
  }
}
